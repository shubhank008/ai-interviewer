# Phase 16 live beta runtime. Use local only for development; production is live-provider-only.
APP_PROFILE=production

# Firebase Web Auth and backend Admin credentials. Never commit secret values.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_API_KEY=
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_DATABASE=(default)

# First live run uses local/NFS-compatible storage. FTP/Firebase are adapter options.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PATH=./var/storage

# Authoritative beta providers and model settings.
DEFAULT_LANGUAGE=en
STT_PROVIDER=whisperx
STT_FALLBACK_PROVIDER=
STT_MODEL=small
STT_CPU=true
STT_LANGUAGE=en
TTS_PROVIDER=kokoro
TTS_FALLBACK_PROVIDER=
TTS_MODEL=default
TTS_LANGUAGE=en

LLM_PROVIDER=openrouter
LLM_FALLBACK_PROVIDER=
LLM_API_KEY=
LLM_MODEL=~deepseek/deepseek-v4-flash-latest

# Browser microphone transport and API security boundaries.
PHASE16_BROWSER_URL=http://localhost:5173
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
WEBRTC_SAMPLE_RATE=48000
CORS_ORIGINS=http://localhost:5173
RETENTION_DAYS=14
AUDIO_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=30
RATE_LIMIT=60
RATE_WINDOW_SECONDS=60

# Operations and observability.
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
METRICS_ENABLED=false
TRACING_ENABLED=false
