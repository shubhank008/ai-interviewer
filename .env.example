# Runtime profile: local is deterministic and offline; production requires providers.
APP_PROFILE=local

# Firebase and Firestore (identifiers only here; never commit secrets).
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_API_KEY=
FIRESTORE_DATABASE=(default)

# Storage: local, s3, or gcs. Bucket is required for remote backends.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_PATH=./var/storage

# Capability provider names and safe model identifiers.
STT_PROVIDER=in-memory
STT_FALLBACK_PROVIDER=in-memory
STT_API_KEY=
# Phase 15 opt-in integration profiles. Empty means no provider integration runs.
# Comma-separated: openrouter,faster-whisper,piper,firebase,firestore,storage,webrtc.
PHASE15_PROFILES=
OPENROUTER_API_KEY=
STT_MODEL_PATH=
TTS_MODEL_PATH=
TTS_COMMAND=
FIREBASE_CREDENTIALS_PATH=
PHASE15_BROWSER_URL=
CLOUD_REGION=

STT_MODEL=base.en
TTS_PROVIDER=in-memory
TTS_FALLBACK_PROVIDER=in-memory
TTS_API_KEY=
TTS_MODEL=default
LLM_PROVIDER=in-memory
LLM_FALLBACK_PROVIDER=in-memory
LLM_API_KEY=
LLM_MODEL=default

# Browser transport and API security boundaries.
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
WEBRTC_SAMPLE_RATE=48000
CORS_ORIGINS=http://localhost:5173
RETENTION_DAYS=14
RATE_LIMIT=60
RATE_WINDOW_SECONDS=60

# Operations and observability.
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
METRICS_ENABLED=false
TRACING_ENABLED=false
