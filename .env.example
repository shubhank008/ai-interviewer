# Phase 16 live beta runtime. Use local only for development; production is live-provider-only.
APP_PROFILE=production

# Firebase Web Auth and backend Admin credentials. Never commit secret values.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_API_KEY=
FIREBASE_CREDENTIALS_PATH=
FIRESTORE_DATABASE=(default)

# Live beta uses Firebase Storage through the gcs selector. Use local only for development.
STORAGE_BACKEND=gcs
STORAGE_BUCKET=gs://the-interviewer-c3a01.firebasestorage.app
STORAGE_PATH=./var/storage

# Authoritative beta providers and model settings.
DEFAULT_LANGUAGE=en
STT_PROVIDER=whisperx
STT_FALLBACK_PROVIDER=whisperx
STT_MODEL=small
STT_CPU=true
STT_LANGUAGE=en
TTS_PROVIDER=kokoro
TTS_FALLBACK_PROVIDER=kokoro
TTS_MODEL=default
TTS_LANGUAGE=en

LLM_PROVIDER=openrouter
LLM_FALLBACK_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=~deepseek/deepseek-v4-flash-latest

# Programmatic agent-to-agent audio is the Phase 16 live transport; browser/WebRTC/TURN are deferred.
PHASE16_BROWSER_URL=http://localhost:5173
WEBRTC_ICE_SERVERS=stun:stun.l.google.com:19302
WEBRTC_SAMPLE_RATE=48000
CORS_ORIGINS=http://localhost:5173
RETENTION_DAYS=14
AUDIO_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=30
RATE_LIMIT=60
RATE_WINDOW_SECONDS=60

# Operations and observability.
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
METRICS_ENABLED=false
TRACING_ENABLED=false
